{
  "name": "bodymate",
  "version": "0.1.0",
  "private": true,
  "description": "Offline anatomy exploration whitebox",
  "scripts": {
    "build": "node scripts/build-anatomy-registry-runtime.mjs && node scripts/build-moonbit.mjs && node scripts/build-root-scm-runtime.mjs",
    "verify": "node scripts/run-moon.mjs check --target js && node scripts/run-moon.mjs test --target js && node --test test/bodymate.contract.test.mjs test/moonbit-integration.test.mjs test/real-neck-spike.test.mjs test/anatomy-asset-decision.test.mjs test/public-scm-asset.test.mjs test/moonbit-ci-install.test.mjs test/root-scm-integration.test.mjs test/anatomy-registry.test.mjs test/neck-presentation.test.mjs test/coach-c-spatial.test.mjs",
    "check": "npm run verify && node scripts/check-generated.mjs",
    "spike:verify-local": "node scripts/verify-local-neck-asset.mjs",
    "spike:serve": "node scripts/serve-spike.mjs",
    "anatomy:fetch-scm": "node scripts/anatomy-fetch-scm.mjs",
    "anatomy:build-scm": "node scripts/anatomy-build-scm.mjs",
    "anatomy:rebuild-scm": "node scripts/anatomy-rebuild-scm.mjs",
    "anatomy:rebuild-human-atlas-neck": "node scripts/rebuild-human-atlas-neck.mjs",
    "anatomy:list-human-atlas": "node scripts/list-human-atlas-structures.mjs",
    "anatomy:serve-scm": "node scripts/serve-public-scm.mjs",
    "root-scm:build-runtime": "node scripts/build-root-scm-runtime.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
